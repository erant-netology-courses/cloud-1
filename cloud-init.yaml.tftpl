write_files:
  - path: /var/www/html/index.html
    content: |
      <!DOCTYPE html>
      <html>
        <head><title>LAMP VM</title></head>
        <body>
          <h1>Hello from LAMP instance</h1>
          <img src="${bucket_url}" width="400" alt="image">
        </body>
      </html>
runcmd:
  - systemctl enable --now apache2